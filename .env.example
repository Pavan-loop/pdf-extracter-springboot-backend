# ── Database ──────────────────────────────────────────────────
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DATABASE_URL=jdbc:postgresql://postgres:5432/pdf_automation

# ── JWT ───────────────────────────────────────────────────────
# Generate: openssl rand -base64 64
JWT_SECRET_KEY=your_base64_secret_key_here
JWT_EXPIRATION=86400000

# ── Kafka ─────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ── Email (Gmail App Password) ────────────────────────────────
# Generate at: myaccount.google.com → Security → App passwords
MAIL_USERNAME=yourapp@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# ── Google OAuth2 ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
OAUTH2_REDIRECT_URI=https://yourdomain.com/oauth2/callback

# ── Admin Seed ────────────────────────────────────────────────
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=ChangeThisStrongPassword@123
ADMIN_NAME=Admin

# ── AWS S3 (file storage) ─────────────────────────────────────
AWS_BUCKET_NAME=your-s3-bucket-name
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# ── Stripe (payments) ─────────────────────────────────────────
# Get from: dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=sk_live_...
# Get from: dashboard.stripe.com → Developers → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_...
# Get from: dashboard.stripe.com → Products → your subscription plan
STRIPE_PRICE_ID=price_...
STRIPE_SUCCESS_URL=https://yourdomain.com/subscription/success
STRIPE_CANCEL_URL=https://yourdomain.com/subscription/cancel

# ── Server ────────────────────────────────────────────────────
PORT=8080
SPRING_PROFILES_ACTIVE=prod
